---
/**
 * A single integration card in the catalog grid. All filterable facets are
 * exposed as data-* attributes; the page script (catalog.astro) toggles
 * visibility, so the card itself stays a pure server-rendered component.
 *
 * The whole card is clickable via the stretched-link pattern: the title
 * anchor's ::after covers the card, and the secondary GitHub/registry links
 * sit above it with a raised z-index so they stay independently clickable.
 * Each entry's tile shows its integration-type glyph in a neutral accent
 * tint, so the tile signals the type at a glance without external logos.
 */
import type { CatalogCardModel } from '../../util/catalog'
import { pathWithBase } from '../../util/links'
import { DOWNLOAD_ICON, GITHUB_ICON, NPM_ICON, PYPI_ICON, STAR_ICON } from './icons'
import { TYPE_ICONS, TYPE_LABELS, VERIFIED_ICON } from './types'

interface Props {
  card: CatalogCardModel
  featured?: boolean
}

const { card, featured = false } = Astro.props

const numberFormat = new Intl.NumberFormat('en', { notation: 'compact' })

// Footer links render brand marks instead of text; the registry label picks
// the icon ('PyPI' → Python snakes, 'npm' → npm block logo).
const REGISTRY_ICONS: Record<string, readonly string[]> = { PyPI: PYPI_ICON, npm: NPM_ICON }

// Internal docs hrefs need the deploy base path; external URLs must not get it.
const href = card.external ? card.href : pathWithBase(card.href)
---

<article
  class:list={['cat-card', { 'cat-card--featured': featured }]}
  data-name={card.name}
  data-type={card.integrationType}
  data-langs={card.languages.join(' ')}
  data-badges={[...card.badges, ...(featured ? ['featured'] : [])].join(' ')}
  data-sdk={card.sdk}
  data-search={`${card.name} ${card.description} by ${card.maintainer}`.toLowerCase()}
>
  <span class="cat-tile" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d={TYPE_ICONS[card.integrationType]} />
    </svg>
  </span>
  <div class="cat-card-main">
    <div class="cat-card-head">
      <a class="cat-card-title" href={href} rel={card.external ? 'noopener' : undefined} title={card.name}>
        {card.name}
      </a>
      {card.external && <span class="cat-external" aria-hidden="true">↗</span>}
      {featured && <span class="cat-flag cat-flag--featured" title="Featured by the Strands team">Featured</span>}
      {
        card.badges.includes('verified') && (
          <span class="cat-flag cat-flag--verified" title="Verified by the Strands team">
            <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={VERIFIED_ICON} />
            </svg>
            Verified
          </span>
        )
      }
      {card.badges.includes('new') && <span class="cat-flag cat-flag--new">New</span>}
      <span class="cat-card-stats">
        {
          card.stars !== undefined && (
            <span class="cat-stat" title="GitHub stars">
              <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={STAR_ICON} />
              </svg>
              {numberFormat.format(card.stars)}
            </span>
          )
        }
        {
          card.downloads !== undefined && (
            <span class="cat-stat" title="Downloads per month">
              <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={DOWNLOAD_ICON} />
              </svg>
              {numberFormat.format(card.downloads)}
            </span>
          )
        }
      </span>
    </div>
    <p class="cat-card-desc">{card.description}</p>
    <div class="cat-card-foot">
      <span class="cat-facts">
        <span class="cat-type">{TYPE_LABELS[card.integrationType]}</span>
        <span class="cat-langs">
          {card.languages.map((l) => (l === 'python' ? 'Python' : 'TypeScript')).join(' · ')} · by {card.maintainer}
        </span>
      </span>
      <span class="cat-links">
        <a class="cat-link" href={card.github} rel="noopener" aria-label={`${card.name} on GitHub`} title="GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            {GITHUB_ICON.map((d) => (
              <path fill="currentColor" d={d} />
            ))}
          </svg>
        </a>
        {card.registryLinks.map((link) => (
          <a
            class="cat-link"
            href={link.href}
            rel="noopener"
            aria-label={`${card.name} on ${link.label}`}
            title={link.label}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
              {(REGISTRY_ICONS[link.label] ?? []).map((d) => (
                <path fill="currentColor" d={d} />
              ))}
            </svg>
          </a>
        ))}
      </span>
    </div>
  </div>
</article>
