---
/**
 * Search input + filter controls for the catalog, following the changelog
 * page's control language (segmented groups, chip rail). Renders static
 * controls with data-cat-* hooks; the page script owns all behavior. The SDK
 * facet only renders when the catalog contains evals entries.
 */
import { TYPE_ICONS, LANG_ICONS } from './icons'

interface FacetOption {
  value: string
  label: string
  count: number
}

interface Props {
  types: FacetOption[]
  showSdkFacet: boolean
}

const { types, showSdkFacet } = Astro.props

const LANGUAGES = [
  { value: 'python', label: 'Python' },
  { value: 'typescript', label: 'TypeScript' },
] as const
---

<form class="cat-filters" role="search" aria-label="Filter catalog" onsubmit="return false">
  <div class="cat-filters-row">
    <div class="cat-search-wrap">
      <svg class="cat-search-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"
        />
      </svg>
      <input
        class="cat-search"
        type="search"
        placeholder="Search integrations…"
        aria-label="Search integrations"
        data-cat-search
      />
    </div>
    {
      showSdkFacet && (
        <div class="cat-seg" role="radiogroup" aria-label="SDK">
          <button class="cat-seg-btn" type="button" role="radio" aria-checked="true" data-cat-sdk="agents">
            Agents
          </button>
          <button class="cat-seg-btn" type="button" role="radio" aria-checked="false" data-cat-sdk="evals">
            Evals
          </button>
        </div>
      )
    }
    <div class="cat-seg" role="group" aria-label="Language">
      {
        LANGUAGES.map((l) => (
          <button class="cat-seg-btn" type="button" data-cat-lang={l.value} aria-pressed="false">
            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
              {LANG_ICONS[l.value].map((p) => (
                <path fill="currentColor" d={p} />
              ))}
            </svg>
            {l.label}
          </button>
        ))
      }
    </div>
    <button class="cat-seg-btn cat-seg-btn--solo" type="button" data-cat-badge="verified" aria-pressed="false">
      <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 1 3 5v6c0 5.6 3.8 10.7 9 12 5.2-1.3 9-6.4 9-12V5l-9-4zm-1.5 15L7 12.5 8.4 11l2.1 2.1 5.1-5.1L17 9.4 10.5 16z"
        />
      </svg>
      Verified
    </button>
  </div>
  <div class="cat-type-rail" role="group" aria-label="Type">
    {
      types.map((t) => (
        <button class="cat-chip" type="button" data-cat-type={t.value} aria-pressed="false">
          <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d={TYPE_ICONS[t.value]} />
          </svg>
          {t.label}
          <span class="cat-count">{t.count}</span>
        </button>
      ))
    }
  </div>
</form>
