---
/**
 * Search trigger + facet controls for the catalog, following the changelog
 * page's control language (segmented groups, chip rail). Renders static
 * controls with data-cat-* hooks; the page script owns all behavior. Facets
 * are shared with the search dialog via CatalogFacets.
 */
import CatalogFacets from './CatalogFacets.astro'

interface FacetOption {
  value: string
  label: string
  count: number
}

interface Props {
  types: FacetOption[]
  showSdkFacet: boolean
}

const { types, showSdkFacet } = Astro.props
---

<form class="cat-filters" role="search" aria-label="Filter catalog" onsubmit="return false">
  <div class="cat-filters-row">
    <button class="cat-search-trigger" type="button" data-cat-search-open aria-label="Search integrations">
      <svg class="cat-search-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"
        />
      </svg>
      <span class="cat-search-label" data-cat-search-label>Search integrations…</span>
      <kbd class="cat-search-kbd">/</kbd>
    </button>
  </div>
  <CatalogFacets types={types} showSdkFacet={showSdkFacet} />
</form>
