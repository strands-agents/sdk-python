---
/**
 * Search trigger + language/SDK segments for the catalog, following the
 * changelog page's control language (segmented groups). Renders static
 * controls with data-cat-* hooks; the page script owns all behavior and
 * binds document-wide, so these controls stay in sync with the search
 * dialog's copies. Type chips and badge filters render in the page's left
 * rail instead of here.
 */
import { LANG_ICONS } from './icons'

interface Props {
  showSdkFacet: boolean
}

const { showSdkFacet } = Astro.props

const LANGUAGES = [
  { value: 'python', label: 'Python' },
  { value: 'typescript', label: 'TypeScript' },
] as const
---

<form class="cat-filters" role="search" aria-label="Filter catalog" onsubmit="return false">
  <div class="cat-filters-row">
    <button class="cat-search-trigger" type="button" data-cat-search-open aria-label="Search integrations">
      <svg class="cat-search-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"
        />
      </svg>
      <span class="cat-search-label" data-cat-search-label>Search integrations…</span>
      <kbd class="cat-search-kbd">/</kbd>
    </button>
  </div>
  <div class="cat-facet-row">
    {
      showSdkFacet && (
        <div class="cat-seg" role="radiogroup" aria-label="SDK">
          <button class="cat-seg-btn" type="button" role="radio" aria-checked="true" data-cat-sdk="agents">
            Agents
          </button>
          <button class="cat-seg-btn" type="button" role="radio" aria-checked="false" data-cat-sdk="evals">
            Evals
          </button>
        </div>
      )
    }
    <div class="cat-seg" role="group" aria-label="Language">
      {
        LANGUAGES.map((l) => (
          <button class="cat-seg-btn" type="button" data-cat-lang={l.value} aria-pressed="false">
            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
              {LANG_ICONS[l.value].map((p) => (
                <path fill="currentColor" d={p} />
              ))}
            </svg>
            {l.label}
          </button>
        ))
      }
    </div>
  </div>
</form>
