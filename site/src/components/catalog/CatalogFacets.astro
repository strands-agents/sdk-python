---
/**
 * Facet controls (SDK, language, verified, type chips) shared by the filter
 * bar and the search dialog. Static markup with data-cat-* hooks; the page
 * script binds every instance document-wide, so multiple copies stay in sync.
 *
 * The filter bar hides the type chips (they live in the page's left rail);
 * the dialog keeps them inline because its space is constrained.
 */
import { LANG_ICONS } from './icons'
import { TYPE_ICONS, VERIFIED_ICON, type FacetOption } from './types'

interface Props {
  types: FacetOption[]
  showSdkFacet: boolean
  hasVerified: boolean
  hasFeatured: boolean
  hasNew: boolean
  showTypes?: boolean
}

const { types, showSdkFacet, hasVerified, hasFeatured, hasNew, showTypes = true } = Astro.props

const LANGUAGES = [
  { value: 'python', label: 'Python' },
  { value: 'typescript', label: 'TypeScript' },
] as const
---

<div class="cat-facet-row">
  {
    showSdkFacet && (
      <div class="cat-seg" role="radiogroup" aria-label="SDK">
        <button class="cat-seg-btn" type="button" role="radio" aria-checked="true" data-cat-sdk="agents">
          Agents
        </button>
        <button class="cat-seg-btn" type="button" role="radio" aria-checked="false" data-cat-sdk="evals">
          Evals
        </button>
      </div>
    )
  }
  <div class="cat-seg" role="group" aria-label="Language">
    {
      LANGUAGES.map((l) => (
        <button class="cat-seg-btn" type="button" data-cat-lang={l.value} aria-pressed="false">
          <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
            {LANG_ICONS[l.value].map((p) => (
              <path fill="currentColor" d={p} />
            ))}
          </svg>
          {l.label}
        </button>
      ))
    }
  </div>
  {
    hasFeatured && (
      <button class="cat-seg-btn cat-seg-btn--solo" type="button" data-cat-badge="featured" aria-pressed="false">
        Featured
      </button>
    )
  }
  {
    hasNew && (
      <button class="cat-seg-btn cat-seg-btn--solo" type="button" data-cat-badge="new" aria-pressed="false">
        New
      </button>
    )
  }
  {
    hasVerified && (
      <button class="cat-seg-btn cat-seg-btn--solo" type="button" data-cat-badge="verified" aria-pressed="false">
        <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d={VERIFIED_ICON} />
        </svg>
        Verified
      </button>
    )
  }
</div>
{
  showTypes && (
    <div class="cat-type-rail" role="group" aria-label="Type">
      {types.map((t) => (
        <button class="cat-chip" type="button" data-cat-type={t.value} aria-pressed="false">
          <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d={TYPE_ICONS[t.value]} />
          </svg>
          {t.label}
          <span class="cat-count">{t.count}</span>
        </button>
      ))}
    </div>
  )
}
