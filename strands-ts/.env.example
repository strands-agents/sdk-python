# ── Model provider for the `strands` CLI ─────────────────────────────────
# Selection order: --provider flag > STRANDS_PROVIDER > auto-detect
# (GROQ_API_KEY, then OPENAI_API_KEY) > SDK default (Bedrock).
# The generic PROVIDER variable is ignored — it belongs to other tooling.

# STRANDS_PROVIDER=groq          # groq | openai | bedrock (default)

# ── Groq (OpenAI-compatible endpoint) ────────────────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ── OpenAI ───────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=               # optional: any OpenAI-compatible gateway

# ── CLI output ───────────────────────────────────────────────────────────
# STRANDS_PLAIN=1                # force raw text, no ANSI/markdown styling
